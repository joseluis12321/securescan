# Copia este archivo como .env y ajusta los valores.
# Las variables de entorno reales tienen prioridad sobre este archivo.

# --- Obligatorio ---------------------------------------------------------
# Genera una clave con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# --- General ---------------------------------------------------------------
# True solo en desarrollo. Nunca True en producción.
DEBUG=False
# Dominios desde los que se sirve la app, separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes https completos si usas un proxy o dominio propio (separados por comas).
# CSRF_TRUSTED_ORIGINS=https://securescan.ejemplo.com
TIME_ZONE=UTC
LOG_LEVEL=INFO
# Ruta del panel de administración (cambiarla reduce el ruido de bots).
# ADMIN_URL=panel-privado/

# --- Servicios (producción) ------------------------------------------------
# Por defecto: SQLite y caché en memoria (válido solo con DEBUG=True).
# DATABASE_URL=postgres://securescan:clave@localhost:5432/securescan
# CACHE_URL=redis://localhost:6379/0

# --- HTTPS (solo se aplica con DEBUG=False) --------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_COOKIES=True
# SECURE_HSTS_SECONDS=31536000
# True si la app está detrás de Nginx/Caddy/Traefik que envía X-Forwarded-Proto y X-Real-IP.
# BEHIND_PROXY=False

# --- SecureScan ------------------------------------------------------------
# True permite escanear redes privadas y localhost (solo para uso local).
SECURESCAN_PERMITIR_REDES_PRIVADAS=False
# Tamaño máximo del log subido, en MB.
SECURESCAN_MAX_LOG_MB=10
# Días que se guardan los análisis (python manage.py purgar_analisis).
SECURESCAN_RETENCION_DIAS=90
# Escaneos de puertos simultáneos por proceso.
SECURESCAN_MAX_ESCANEOS_SIMULTANEOS=4
